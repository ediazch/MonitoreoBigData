  "mainPath": ["inicio", "carga_ods", "limpieza", "normalizar", "cruce", "reporte", "dashboard"],
  "nodes": [
    { "id": "inicio",     "lane": "entrada",  "col": 0, "type": "external",    "label": "Archivos fuente",  "sublabel": "ODS + CSV",              "width": 140 },
