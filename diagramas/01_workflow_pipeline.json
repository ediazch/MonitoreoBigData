    { "from": "normalizar",  "to": "cruce",     "label": "normalizado",    "variant": "emphasis" },
    { "from": "validar",    "to": "cruce",      "label": "limpio",         "variant": "dashed" },
    { "from": "cruce",      "to": "gaps",       "label": "35 sin cubrir",  "variant": "security", "role": "error" },
    { "from": "cruce",      "to": "reporte",    "label": "662 matches",    "variant": "emphasis" },
    { "from": "reporte",    "to": "dashboard",  "label": "genera HTML",    "variant": "dashed" }
