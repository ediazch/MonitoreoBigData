    { "id": "reporte",    "lane": "salida",   "col": 4, "type": "backend",     "label": "Reporte consola",  "sublabel": "IDs enmascarados",         "width": 140 },
    { "id": "dashboard",  "lane": "salida",   "col": 5, "type": "frontend",    "label": "dashboard.html",   "sublabel": "visualizacion interactiva","width": 140 }
