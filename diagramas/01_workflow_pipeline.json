  "cards": [
    { "dot": "cyan",    "title": "Fuentes de datos",   "items": ["ODS: 10 hojas por tipo de documento (CC, CE, TI, PAS...)", "CSV: 666 registros de casos de prueba QA", "Clave de union: tipo_id + num_id"] },
    { "dot": "rose",    "title": "Calidad aplicada",   "items": ["Normalizacion: strip, remove comillas, guiones, espacios", "Deduplicacion por clave compuesta tipo_id + num_id", "Filtro: tipo e ID deben ser numericos"] },
    { "dot": "emerald", "title": "Resultados criticos", "items": ["662 coincidencias — cobertura 99.4%", "Tipo 13 PPT: solo 50% de cobertura — GAP CRITICO", "4 IDs solo en CSV, 35 solo en ODS"] }
  ]
